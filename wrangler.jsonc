{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fmail",
	"compatibility_date": "2025-11-26",
	"main": "./workers/app.ts",
	"secrets": {
		"required": ["SESSION_SECRETS", "MAIL_DOMAIN", "MAIL_DOMAINS"]
	},
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	"routes": [
		{ "pattern": "mail.zjjqw.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "fmail",
			"database_id": "9772dcbc-8e91-48e0-bddd-24240a08e0d7",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "fmail"
		}
	]
}
